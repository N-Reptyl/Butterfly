{% macro decorativeTitle(text, variant, level="h2", containerClass="mb-8", topLineClass="") %}
  {% if variant == "whitish" %}
    {% set lineColor = "border-dark/20" %}
    {% set titleColor = "bg-[#418a7a]/20" %}
  {% elif variant == "hero-gradient" %}
    {% set lineColor = "border-white/80" %}
    {% set titleColor = "bg-white/10" %}
  {% endif %}

  <div class="flex w-full items-center {{ containerClass }}">
    <!-- Trait gauche -->
    <span class="flex-1 border-t-2 {{ lineColor }}"></span>

    {% if level == "h1" %}
      <h1 class=" mx-6 text-2xl md:text-3xl font-extrabold uppercase tracking-wide text-center px-8 py-1 {{ titleColor }} border-y-2 {{ lineColor }}">
        {{ text }}
      </h1>
    {% else %}
      <h2 class="text-2xl md:text-3xl font-extrabold uppercase tracking-wide text-center px-8 py-1 {{ titleColor }} border-y-2 {{ lineColor }}">
        {{ text }}
      </h2>
    {% endif %}

    <!-- Trait droit -->
    <span class="flex-1 border-t-2 {{ lineColor }}"></span>
  </div>
{% endmacro %}